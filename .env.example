# =============================================================================
# Autonomous Drug Repurposing Intelligence Platform — Environment Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env — it is listed in .gitignore.

# ─── Google AI Studio (Gemini LLM + Embeddings) ──────────────────────────────
GOOGLE_API_KEY=

# ─── Supabase (PostgreSQL) ────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_PAT=

# ─── Qdrant Cloud (Vector Store) ─────────────────────────────────────────────
QDRANT_URL=https://<cluster-id>.<region>.cloud.qdrant.io
QDRANT_API_KEY=

# ─── Upstash Redis ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ─── DeepSeek / OpenRouter ───────────────────────────────────────────────────
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# ─── DrugBank Open ────────────────────────────────────────────────────────────
DRUGBANK_API_KEY=

# ─── NCBI / PubMed Entrez ────────────────────────────────────────────────────
NCBI_API_KEY=

# ─── OpenFDA ─────────────────────────────────────────────────────────────────
OPENFDA_API_KEY=

# ─── EPO Open Patent Services ─────────────────────────────────────────────────
EPO_CLIENT_ID=
EPO_CLIENT_SECRET=

# ─── Application Settings ─────────────────────────────────────────────────────
MAX_CONCURRENT_RESEARCH_SESSIONS=3
RETRIEVAL_TIMEOUT_SECONDS=30
MAX_CHUNKS_PER_DOMAIN=20
MAX_LLM_RETRIES=4

# ─── LangSmith (optional) ─────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=drug-repurposing-platform
